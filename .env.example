# Copy to .env and fill in. NEVER commit .env.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
# Paper: https://paper-api.alpaca.markets   Live: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# false = simulate locally, true = talk to Alpaca at ALPACA_BASE_URL
USE_ALPACA=false
# Extra guard: orders are only sent when this is exactly "true"
INCOME_LIVE_ORDERS=false

# Income platform
INCOME_TARGET_MONTHLY=500
INCOME_TOLERANCE=50
INCOME_MIN_RESERVE_MONTHS=6
INCOME_INSTRUMENT=SGOV
INCOME_PLANNING_YIELD=0.0365
INCOME_LEDGER_PATH=data/income_ledger.json

# Legacy mean-reversion bot (not used by the income platform)
CAPITAL=100000
LOOKBACK=20
ENTRY_Z=1.5
EXIT_Z=0.5
MAX_POSITION=0.05
