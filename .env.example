# Copy to .env and fill in. NEVER commit .env.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex          # 'sip' requires Algo Trader Plus at $99/month

# Two independent flags. BOTH must be exactly "true" before any order is sent.
USE_ALPACA=false
HFT_LIVE_ORDERS=false

# Capital and target
HFT_CAPITAL=3000
HFT_MONTHLY_TARGET=500
HFT_TARGET_TOLERANCE=50
HFT_STOP_AT_TARGET=true
HFT_STATE_PATH=data/hft_state.json

# Strategy
HFT_SYMBOLS=SPY,QQQ
HFT_LOOKBACK=20
HFT_ENTRY_Z=2.0
HFT_EXIT_Z=0.3
HFT_STOP_Z=3.5
HFT_HOLD_LIMIT=10
HFT_COOLDOWN=2
HFT_TRADE_START=09:45
HFT_TRADE_END=15:50

# Risk limits (defaults are derived from HFT_CAPITAL)
RISK_MAX_DAILY_LOSS=90
RISK_MAX_MONTHLY_LOSS=300
RISK_MAX_TRADE_RISK=15
RISK_MAX_POSITION=3000        # raise only to use leverage; see README
RISK_MAX_CONSEC_LOSSES=6
RISK_MAX_TRADES_PER_DAY=40
RISK_MIN_EQUITY=2400

# Cost model
COST_SPREAD_BPS=1.5
COST_SPREAD_CAPTURE=1.0
COST_SLIPPAGE_BPS=0.5
COST_SEC_FEE_PER_M=20.60
COST_TAF_PER_SHARE=0.000166
